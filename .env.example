# Copy to .env (gitignored) and fill in your local MySQL credentials.
API_PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rodpartpicker

# Auth secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
CODE_HMAC_SECRET=
# Dev runs on plain http, so cookies can't be Secure
COOKIE_SECURE=false

# Login-code email. "console" prints the code in the API's terminal (dev);
# "resend" emails it through Resend (https://resend.com), which needs an API key.
EMAIL_BACKEND=console
RESEND_API_KEY=
# Resend's shared test sender only delivers to your own Resend account's
# address. To email anyone, verify a domain in Resend and use it here, e.g.
# EMAIL_FROM="RodPartPicker <login@yourdomain.com>"
EMAIL_FROM="RodPartPicker <onboarding@resend.dev>"
